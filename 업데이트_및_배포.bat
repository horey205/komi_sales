@echo off
title SalesDB 자동 업데이트 및 배포 도구
echo.
echo ============================================================
echo   SalesDB 최신 코드를 GitHub에 저장하고 배포를 시작합니다.
echo ============================================================
echo.

set /p msg="업데이트 메시지를 입력하세요 (엔터 치면 '자동 업데이트'로 설정): "
if "%msg%"=="" set msg=자동 업데이트 %date% %time%

echo.
echo [1/4] 단계: 변경된 파일 실어서 보낼 준비 중...
git add .

echo.
echo [2/4] 단계: 업데이트 기록 작성 중...
git commit -m "%msg%"

echo.
echo [3/4] 단계: GitHub 서버로 소스 코드 전송 중...
git push

echo.
echo [4/4] 단계: 웹사이트 빌드 및 최종 배포 중 (시간이 좀 걸립니다)...
npm run deploy

echo.
echo ============================================================
echo   완료되었습니다! 약 1분 뒤 GitHub 사이트에서 확인하세요.
echo ============================================================
echo.
pause
